<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Spendio is offline-first: capture, parsing, storage and the UI never touch the network.
      INTERNET is used for ONE opt-in feature only — Google Drive backup — and even then only
      passphrase-encrypted ciphertext is uploaded (the data stays unreadable to Google and us).
      Default is off.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Lets Spendio ask the user, once, to exempt it from battery optimization — the most common
      reason the notification listener gets silently killed in the background on stock/MIUI/
      ColorOS devices. A normal permission; the actual ask is a one-time system dialog (see
      BatteryOptimization.kt), not a runtime grant.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".SpendioApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spendio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Spendio.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the exported CSV from cache via a content:// URI (no external storage perms). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Notification listener. The system binds this only after the user grants
          "Notification access" in settings; the signature-level BIND permission keeps
          any other app from binding it. This is how Spendio captures transactions
          without READ_SMS.
        -->
        <service
            android:name=".capture.TxnNotificationListenerService"
            android:exported="false"
            android:label="@string/capture_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
