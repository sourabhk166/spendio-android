<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup / device-transfer rules for Android 12+ (dataExtractionRules).
  Same policy as backup_rules.xml: only the passphrase-encrypted blob is included, so the cloud
  backup and any device-to-device transfer carry ciphertext only.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="autobackup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="autobackup/" />
    </device-transfer>
</data-extraction-rules>
