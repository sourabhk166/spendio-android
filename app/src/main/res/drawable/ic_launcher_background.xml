<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background for the "Flow" mark: a deep-teal vertical gradient (lighter top →
  near-black bottom) that makes the teal→amber S pop. The splash window background (themes.xml)
  is the solid mid value #0C4D3A, which sits between these two stops so the icon and the splash
  feel like one surface.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:startColor="#0E5740"
                android:endColor="#08382B" />
        </aapt:attr>
    </path>

</vector>
