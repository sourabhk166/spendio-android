<?xml version="1.0" encoding="utf-8"?>
<!--
  Spendio adaptive-icon foreground — the "Flow" monogram. A single S whose top half flows
  teal (money in) into an amber bottom half (money out); the two round-capped strokes meet
  tangent-to-tangent at the centre, so it reads as one continuous ribbon. Sized to sit inside
  the central ~72dp safe zone of this 108×108dp canvas, so no launcher mask (circle, squircle,
  rounded-square) ever clips it. Also serves as the Android-12 splash icon.

  Drawn as strokes (not a filled outline) on purpose: a stroke with a gradient is unsupported
  on some renderers, so the two-tone effect is two solid-coloured stroke paths instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#2FCB9B"
        android:strokeWidth="12.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M66.67,37.84 C66.67,33.47 59.68,30.85 54,30.85 C46.14,30.85 40.02,35.65 40.02,42.64 C40.02,48.76 45.26,51.82 54,54" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB84D"
        android:strokeWidth="12.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,54 C62.74,56.18 67.98,59.24 67.98,65.36 C67.98,72.35 62.30,77.15 54,77.15 C48.32,77.15 41.33,74.97 41.33,70.16" />

</vector>
