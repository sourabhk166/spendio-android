<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bare platform theme used only for the activity window before Compose draws.
      All real theming is done in Compose (ui/theme/Theme.kt). Parenting on a
      platform theme avoids a dependency on the Material XML components library.
    -->
    <style name="Theme.Khaata" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Splash screen theme. The activity starts with this theme; installSplashScreen()
      transitions to Theme.Khaata once the first Compose frame is ready.
    -->
    <style name="Theme.Khaata.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1D9E75</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Khaata</item>
    </style>
</resources>
