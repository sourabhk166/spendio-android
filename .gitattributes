# Normalize line endings to avoid CRLF issues across machines/CI.
* text=auto

# The Gradle wrapper script MUST stay LF — CRLF breaks it on the Linux CI runner.
gradlew text eol=lf

# Windows batch scripts use CRLF.
*.bat text eol=crlf

# Binary assets must never be line-ending converted.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
